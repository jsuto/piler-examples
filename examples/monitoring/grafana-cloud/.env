# From your Grafana Cloud stack: Connections > Add new connection > Hosted
# Prometheus metrics / Hosted logs show the URLs and the user ids. The API
# key is an access policy token with metrics:write (and logs:write).
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-eu-west-2.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=123456
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=654321
GRAFANA_CLOUD_API_KEY=changeme

# A label on every metric and log line, to tell your deployments apart
PILER_DEPLOYMENT=hosting-eu1

# piler's Docker network
PILER_NETWORK=piler
