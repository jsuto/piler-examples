# Settings of a worker node. Docker compose reads this file, the values go
# to the containers through docker-compose.yaml. Copy this directory to
# every worker and change the values.

# The name of this worker, the one in WORKERS and MANTICORE_WORKERS on the
# master (its license has the matching server id)
WORKER_NAME=worker0.example.internal

# The private address of this host: the master reaches piler-ui (3000) and
# Manticore (9312) on it, never expose these ports to the internet
PRIVATE_IP=10.0.0.20

# The private hostname of the master (MariaDB 3306, Manticore 9307)
MASTER_HOST=master.example.internal

# Who may read piler-ui's /metrics and /healthz: the master checks the
# workers' health, and your monitoring scrapes them, on the private network
ALLOWED_CIDRS=127.0.0.0/8,10.0.0.0/24

# The piler password must be the master's: the worker logs in to the
# master's database with it to copy the rules of the tenants
MYSQL_PASSWORD=changeme-mysql
MYSQL_ROOT_PASSWORD=changeme-mysql-root

# The same on every node
JWT_SECRET=changeme-jwt-secret-at-least-32-characters
IMAP_ENCRYPT_KEY=changeme-imap-key

# S3-compatible object storage for the emails, a bucket per tenant
# (S3_BUCKET_PREFIX + tenant id)
S3_ENDPOINT=s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_USE_SSL=true
S3_BUCKET_PREFIX=

PILER_VERSION=2.2.5
PILER_SMTP_VERSION=1.1.7
SCANNER_VERSION=1.3.1
