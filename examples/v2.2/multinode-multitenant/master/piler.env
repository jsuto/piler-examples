# Settings of piler-ui on the master. Passwords, secrets and the list of
# workers come from .env through docker-compose.yaml.

LICENSE_FILE=/etc/piler/license.jwt
LISTEN_ADDR=:3000

MULTINODES=true
NODE_TYPE=master

MYSQL_USER=piler
MYSQL_HOST=mysql:3306
MYSQL_MAX_OPEN_CONN=30
MYSQL_MAX_IDLE_CONN=10
MYSQL_CONN_MAX_LIFETIME=300s

MANTICORE_DSN=tcp(manticore:9306)/?parseTime=true
MANTICORE_READONLY_DSN=tcp(manticore:9307)/?parseTime=true

REDIS_ADDR=cache:6379

# The proxy in front of piler-ui (traefik)
TRUSTED_PROXIES=172.16.0.0/12

HEADER_LINK=https://example.com/
HEADER_LINK_TITLE=EXAMPLE archive

LOG_LEVEL=INFO

# Restored emails go back to the users' mailboxes through this host
SMARTHOST=smarthost.example.com
SMARTHOST_PORT=25
NOREPLY_EMAIL=no-reply@archive.example.com

ENABLE_DELETE=true
NEED_TO_APPROVE_DELETE=true
