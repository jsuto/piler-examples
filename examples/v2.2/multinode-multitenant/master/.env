# Settings of the master node. Docker compose reads this file, the values
# go to the containers through docker-compose.yaml. Change every password.

# The private address of this host: the workers reach MariaDB and Manticore
# on it, never expose these ports to the internet
PRIVATE_IP=10.0.0.10

# The admin UI of the master (the "piler" tenant)
PILER_HOSTNAME=archive.example.com

# The workers, in the order of their server id (0, 1, ...): the URL of their
# piler-ui, and the host of their Manticore (port 9312)
WORKERS=http://worker0.example.internal:3000,http://worker1.example.internal:3000
MANTICORE_WORKERS=worker0.example.internal,worker1.example.internal

MYSQL_PASSWORD=changeme-mysql
MYSQL_ROOT_PASSWORD=changeme-mysql-root

# The same on every node: the master passes the user's token to the workers
JWT_SECRET=changeme-jwt-secret-at-least-32-characters
IMAP_ENCRYPT_KEY=changeme-imap-key

ACME_EMAIL=hostmaster@example.com

PILER_VERSION=2.2.5
