# Template of env, the settings of piler, piler-ui and the scanner.
# setup.sh copies it to env and fills in the @@...@@ values; change env, not
# this file. The cron jobs of the piler container read env, not the
# container's environment: the database password must be here.

LICENSE_FILE=/etc/piler/license.jwt

LISTEN_ADDR=:3000

MYSQL_USER=piler
MYSQL_PASSWORD=@@MYSQL_PASSWORD@@
MYSQL_HOST=mysql:3306
MYSQL_MAX_OPEN_CONN=30
MYSQL_MAX_IDLE_CONN=10
MYSQL_CONN_MAX_LIFETIME=300s

MANTICORE_DSN=tcp(manticore:9306)/?parseTime=true
MANTICORE_READONLY_DSN=tcp(manticore:9307)/?parseTime=true
REDIS_ADDR=cache:6379

# The proxy in front of piler-ui: traefik's fixed address in docker-compose.yaml.
# Only its X-Forwarded-For counts: with a broader range any container could
# set the client address of the audit log, the lockout and the rate limiter
TRUSTED_PROXIES=172.31.250.10

# Who may read /metrics and /healthz: the containers on this host. A request
# through traefik counts as its client's address.
ALLOWED_CIDRS=127.0.0.0/8,172.16.0.0/12

HEADER_LINK=https://@@PILER_HOSTNAME@@/
HEADER_LINK_TITLE=Email archive

# piler-ui signs its tokens (the REST API, the Outlook add-in) with it
JWT_SECRET=@@JWT_SECRET@@

LOG_LEVEL=INFO

# Restored emails go back to the users' mailboxes through this host
SMARTHOST=@@SMARTHOST@@
SMARTHOST_PORT=@@SMARTHOST_PORT@@
NOREPLY_EMAIL=no-reply@@@PILER_HOSTNAME@@

ENABLE_DELETE=true
NEED_TO_APPROVE_DELETE=false

TIKA_URL=http://tika:9998/tika

ML_PHISHING_ENABLED=true
ML_PHISHING_THRESHOLD=0.5
SECURITY_RISK_ENABLED=true
COMPLIANCE_RISK_ENABLED=true
SCAN_RATE_LIMIT=1000
SMART_INSIGHTS_ENABLED=true

## This must match number_of_worker_processes in piler.conf
PILER_THREADS=3

# Encrypts the IMAP passwords piler-ui stores
IMAP_ENCRYPT_KEY=@@IMAP_ENCRYPT_KEY@@

SEMANTIC_SEARCH_ENABLED=false
